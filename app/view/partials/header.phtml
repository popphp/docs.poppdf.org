<?php
/**
 * Site header. Expects $attr. Sits above the search overlay and the mobile nav drawer, both of
 * which it opens through Alpine's global store.
 *
 * $hasNav is false on the status pages (404, 500, 503), which carry no section nav — the drawer
 * button would open an empty panel.
 *
 * $internalLinks is false in maintenance mode, where every path answers with the same page: a
 * link home would just render it again, so the logo and the in-site nav go inert and only the
 * links that leave the site remain.
 */
$hasNav        = $hasNav ?? true;
$internalLinks = $internalLinks ?? true;
// The overlay is only included where it can work; without this the button would be dead on the
// 500 and 503 pages, and on 503 the index it fetches is the maintenance page itself.
$hasSearch     = $hasSearch ?? true;
?>
<header class="sticky top-0 z-40 border-b border-line bg-bg/95 backdrop-blur">
    <div class="flex items-center gap-4 px-5 py-2.5 lg:gap-7 lg:px-8">

<?php if ($hasNav): ?>
        <button type="button" class="tap-target lg:hidden" @click="$store.docs.toggleNav()"
                :aria-expanded="$store.docs.nav.toString()" aria-controls="docs-nav" aria-label="Open navigation">
            <svg x-show="!$store.docs.nav" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
            <svg x-show="$store.docs.nav" x-cloak viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
        </button>
<?php endif; ?>

<?php if ($internalLinks): ?>
        <a href="/" class="brand shrink-0" aria-label="Pop PDF documentation home">
<?php $markSize = 30; $markStroke = '2.7'; include __DIR__ . '/mark.phtml'; ?>
            <span class="wordmark">Pop PDF</span>
        </a>
<?php else: ?>
        <span class="brand shrink-0">
<?php $markSize = 30; $markStroke = '2.7'; include __DIR__ . '/mark.phtml'; ?>
            <span class="wordmark">Pop PDF</span>
        </span>
<?php endif; ?>

        <span class="tag hidden px-2.5 py-0.5 text-[11px] sm:inline">v6.2</span>

        <div class="flex grow justify-end lg:justify-center">
<?php if ($hasSearch): ?>
            <button type="button" @click="$store.docs.openSearch()"
                    class="flex w-full max-w-[340px] items-center gap-2.5 rounded-full border border-line bg-panel px-3.5 py-2 text-sm text-muted transition-colors duration-150 hover:border-pop-blue/40">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
                <span class="grow text-left">Search</span>
                <span class="key hidden sm:inline">⌘K</span>
            </button>
<?php endif; ?>
        </div>

        <nav class="hidden items-center gap-6 lg:flex">
<?php if ($internalLinks): ?>
            <a href="https://www.poppdf.org" class="nav-link" target="_blank" rel="noopener noreferrer">poppdf.org</a>
<?php endif; ?>
            <a href="https://github.com/popphp/pop-pdf" class="nav-link" target="_blank" rel="noopener noreferrer">GitHub</a>
        </nav>

        <button type="button" class="tap-target" @click="$store.docs.toggleTheme()"
                :aria-label="$store.docs.dark ? 'Switch to light mode' : 'Switch to dark mode'"
                aria-label="Toggle dark mode">
            <svg x-show="$store.docs.dark" x-cloak viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"></path></svg>
            <svg x-show="!$store.docs.dark" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13.5A8.5 8.5 0 1 1 10.5 4a6.8 6.8 0 0 0 9.5 9.5Z"></path></svg>
        </button>
    </div>
</header>
