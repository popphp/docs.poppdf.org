<span class="text-type">Pdf</span>::<span class="text-fn">writeToFile</span>(<span class="text-var">$document</span>, <span class="text-type">filename</span>: <span class="text-kw">__DIR__</span> . <span class="text-str">&#039;/test.pdf&#039;</span>);

