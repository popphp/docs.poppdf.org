<span class="text-var">$label</span> = <span class="text-kw">new</span> <span class="text-type">Text</span>(<span class="text-str">&#039;CONFIDENTIAL&#039;</span>, <span class="text-type">size</span>: <span class="text-num">10</span>);

<span class="text-var">$page1</span> = <span class="text-kw">new</span> <span class="text-type">Page</span>(<span class="text-type">Page</span>::<span class="text-num">LETTER</span>);
<span class="text-var">$page1</span>-&gt;<span class="text-fn">addText</span>(<span class="text-var">$label</span>, <span class="text-str">&#039;Arial&#039;</span>, <span class="text-type">x</span>: <span class="text-num">20</span>, <span class="text-type">y</span>: <span class="text-num">20</span>);

<span class="text-var">$page2</span> = <span class="text-kw">new</span> <span class="text-type">Page</span>(<span class="text-type">Page</span>::<span class="text-num">LETTER</span>);
<span class="text-var">$page2</span>-&gt;<span class="text-fn">addText</span>(<span class="text-var">$label</span>, <span class="text-str">&#039;Arial&#039;</span>, <span class="text-type">x</span>: <span class="text-num">20</span>, <span class="text-type">y</span>: <span class="text-num">20</span>);

<span class="text-var">$document</span>-&gt;<span class="text-fn">addPage</span>(<span class="text-var">$page1</span>);
<span class="text-var">$document</span>-&gt;<span class="text-fn">addPage</span>(<span class="text-var">$page2</span>);

<span class="text-type">Pdf</span>::<span class="text-fn">writeToFile</span>(<span class="text-var">$document</span>, <span class="text-type">filename</span>: <span class="text-kw">__DIR__</span> . <span class="text-str">&#039;/labeled.pdf&#039;</span>);
