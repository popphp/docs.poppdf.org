<pre><code><span class="text-kw">use</span> <span class="text-type">Pop\Pdf\Document</span>;
<span class="text-kw">use</span> <span class="text-type">Pop\Pdf\Document\Page</span>;
<span class="text-kw">use</span> <span class="text-type">Pop\Pdf\Document\Page\Text</span>;
<span class="text-kw">use</span> <span class="text-type">Pop\Pdf\Document\Font</span>;
