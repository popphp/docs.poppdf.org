<pre><code><span class="text-kw">use</span> <span class="text-type">Pop\Pdf\Document\Security</span>;

<span class="text-var">$security</span> = <span class="text-kw">new</span> <span class="text-type">Security</span>(<span class="text-str">&#039;open-me&#039;</span>, <span class="text-type">algorithm</span>: <span class="text-type">Security</span>::<span class="text-num">AES_128</span>);
<span class="text-var">$security</span>-&gt;<span class="text-fn">getAlgorithm</span>(); <span class="text-comment">// &#039;AES128&#039; — &#039;AES256&#039; is the default</span>
</code></pre>
